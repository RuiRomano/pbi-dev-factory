/// Disconnected Product B selection for directional market basket associations. Refreshed from Product in the same model; never filters Sales directly.
table 'Product (Basket)'

	column ProductKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [ProductKey]

	column Product
		dataType: string
		isDefaultLabel
		summarizeBy: none
		sourceColumn: [Product]

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: [Category]

	column Subcategory
		dataType: string
		summarizeBy: none
		sourceColumn: [Subcategory]

	hierarchy 'Product Hierarchy'
		level Category
			column: Category
		level Subcategory
			column: Subcategory
		level Product
			column: Product

	partition 'Product (Basket)' = calculated
		mode: import
		source =
				SELECTCOLUMNS (
				    'Product',
				    "ProductKey", 'Product'[ProductKey],
				    "Product", 'Product'[Product],
				    "Category", 'Product'[Category],
				    "Subcategory", 'Product'[Subcategory]
				)
