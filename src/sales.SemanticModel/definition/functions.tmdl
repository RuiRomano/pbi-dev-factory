/// Table Assertions - PQL.Assert.Tbl namespace
/// Table-level assertion functions for schema and structure validation
/// Publisher: PQL (Power Query Lint)
/// Asserts that a table has at least one row.
function 'PQL.Assert.Tbl.ShouldHaveRows' =
		(testName : STRING, tableRef : TABLE EXPR) =>
			VAR _RowCount = COUNTROWS(tableRef)
			VAR _Passed = _RowCount > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table has rows",
				"Actual", IF(_Passed, "HAS ROWS (" & FORMAT(_RowCount, "0") & ")", "EMPTY (0 rows)"),
				"Passed", _Passed
			)
	lineageTag: 49068057-9dc6-4c27-8a80-78094393071f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

function 'Tests.Run' =
		() =>
		UNION (
		    PQL.Assert.Tbl.ShouldHaveRows ( "Sales should have rows", 'Sales' ),
		    PQL.Assert.Tbl.ShouldHaveRows ( "Customer should have rows", 'Customer' ),
			// Tests [# New Customers]
		    VAR actual =
		        CALCULATE (
		            [# New Customers],
		            TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		            TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		            TREATAS ( { "Southridge Video" }, 'Product'[Brand] ),
		            TREATAS ( { DATE ( 2017, 6, 27 ) }, 'Calendar'[Date] )
		        )
		    RETURN
		        PQL.Assert.ShouldEqual ( "1 brand - positive: first purchase", 1, actual ),
		    VAR actual =
		        COALESCE (
		            CALCULATE (
		                [# New Customers],
		                TREATAS ( { 357592 }, 'Customer'[CustomerKey] ),
		                TREATAS ( { "Cell phones" }, 'Product'[Category] ),
		                TREATAS ( { "Contoso" }, 'Product'[Brand] ),
		                TREATAS ( { DATE ( 2019, 12, 25 ) }, 'Calendar'[Date] )
		            ),
		            0
		        )
		    RETURN
		        PQL.Assert.ShouldEqual ( "1 brand - negative: repeat purchase is not new", 0, actual ),
		    CALCULATETABLE (
		        PQL.Assert.ShouldEqual ( "Returning - first purchase returns zero", 0, [# Returning Customers] ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Southridge Video" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2017, 6, 27 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - repeat purchase", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "Returning - repeat fixture has current sales", 1, [# Customers (w/ Sales)] ),
		            PQL.Assert.ShouldEqual ( "Returning - repeat fixture has earlier purchase", DATE ( 2017, 11, 8 ), CALCULATE ( MIN ( 'Sales'[Order Date] ), REMOVEFILTERS ( 'Calendar' ) ) )
		        ),
		        TREATAS ( { 357592 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Cell phones" }, 'Product'[Category] ),
		        TREATAS ( { "Contoso" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 25 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - earlier selected brand", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - earlier selected brand excludes new", 0, COALESCE ( [# New Customers], 0 ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Southridge Video", "Tailspin Toys" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - excluded brand and category do not qualify", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - excluded brand and category preserve new", 1, [# New Customers] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Tailspin Toys", "Contoso" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - earlier purchase in excluded brand", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - earlier purchase in excluded brand", 1, [# New Customers] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Tailspin Toys" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - earlier selected category qualifies", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - earlier selected category excludes new", 0, COALESCE ( [# New Customers], 0 ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Tailspin Toys", "Contoso" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - same-day first purchase is new only", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - same-day rows count once", 1, [# New Customers] ),
		            PQL.Assert.ShouldEqual ( "Customers - same-day rows count once", 1, [# Customers (w/ Sales)] ),
		            PQL.Assert.ShouldEqual ( "Returning - same-day fixture has multiple rows", 3, COUNTROWS ( 'Sales' ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2017, 6, 27 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - multiple repeat rows count once", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - multiple repeat rows are not new", 0, COALESCE ( [# New Customers], 0 ) ),
		            PQL.Assert.ShouldEqual ( "Returning - multiple repeat fixture has two rows", 2, COUNTROWS ( 'Sales' ) )
		        ),
		        TREATAS ( { 215446 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2018, 6, 25 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - first and later purchases in period", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - first and later purchases in period", 1, [# New Customers] ),
		            PQL.Assert.ShouldEqual ( "Customers - first and later purchases count once", 1, [# Customers (w/ Sales)] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        DATESBETWEEN ( 'Calendar'[Date], DATE ( 2017, 6, 27 ), DATE ( 2019, 12, 4 ) )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - noncontiguous total recalculates", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - noncontiguous total counts customer once", 1, [# New Customers] ),
		            PQL.Assert.ShouldEqual ( "Returning - daily sum differs from period total", 1, SUMX ( VALUES ( 'Calendar'[Date] ), [# Returning Customers] ) ),
		            VAR results =
		                SUMMARIZECOLUMNS (
		                    ROLLUPADDISSUBTOTAL ( 'Calendar'[Date], "IsTotal" ),
		                    "Customers", [# Customers (w/ Sales)],
		                    "New", [# New Customers],
		                    "Returning", [# Returning Customers]
		                )
		            RETURN
		                PQL.Assert.ShouldBeTrue ( "Returning - noncontiguous rows and total reconcile", COUNTROWS ( results ) = 3 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2017, 6, 27 ), DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldBeNull ( "Returning - no sales returns blank", [# Returning Customers] ),
		            PQL.Assert.ShouldBeNull ( "Customers - no sales fixture", [# Customers (w/ Sales)] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2017, 1, 1 ) }, 'Calendar'[Date] )
		    ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( 'Calendar'[Date], "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - date rows and grand total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( 'Calendar'[Year-Month], "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - month rows and grand total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( 'Customer'[CustomerKey], "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - customer rows and grand total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( ROLLUPGROUP ( 'Product'[Category], 'Product'[Brand] ), "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - category brand rows and total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldNotBeNull ( "Margin LY - prior month has data", [MARGIN (LY)] ),
		            PQL.Assert.ShouldEqual (
		                "Margin LY - month preserves category and brand",
		                CALCULATE ( [Margin], REMOVEFILTERS ( 'Calendar' ), DATESBETWEEN ( 'Calendar'[Date], DATE ( 2018, 6, 1 ), DATE ( 2018, 6, 30 ) ) ),
		                [MARGIN (LY)]
		            ),
		            PQL.Assert.ShouldNotBeNull ( "Margin YTD - year to date has data", [MARGIN (YTD)] ),
		            PQL.Assert.ShouldEqual (
		                "Margin YTD - midyear preserves category and brand",
		                CALCULATE ( [Margin], REMOVEFILTERS ( 'Calendar' ), DATESBETWEEN ( 'Calendar'[Date], DATE ( 2019, 1, 1 ), DATE ( 2019, 6, 30 ) ) ),
		                [MARGIN (YTD)]
		            )
		        ),
		        TREATAS ( { 2019 }, 'Calendar'[Year] ),
		        TREATAS ( { 6 }, 'Calendar'[Month] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Southridge Video" }, 'Product'[Brand] )
		    ),
		    CALCULATETABLE (
		        PQL.Assert.ShouldEqual (
		            "Margin LY - single day",
		            CALCULATE ( [Margin], REMOVEFILTERS ( 'Calendar' ), TREATAS ( { DATE ( 2018, 6, 25 ) }, 'Calendar'[Date] ) ),
		            [MARGIN (LY)]
		        ),
		        TREATAS ( { DATE ( 2019, 6, 25 ) }, 'Calendar'[Date] ),
		        TREATAS ( { 215446 }, 'Customer'[CustomerKey] )
		    ),
		    CALCULATETABLE (
		        PQL.Assert.ShouldBeNull ( "Margin LY - before calendar start is blank", [MARGIN (LY)] ),
		        TREATAS ( { 2017 }, 'Calendar'[Year] )
		    ),
		    CALCULATETABLE (
		        PQL.Assert.ShouldEqual ( "Margin YTD - January 1 resets the year", [Margin], [MARGIN (YTD)] ),
		        TREATAS ( { DATE ( 2019, 1, 1 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        PQL.Assert.ShouldEqual ( "Margin YTD - full year total", [Margin], [MARGIN (YTD)] ),
		        TREATAS ( { 2019 }, 'Calendar'[Year] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldBeNull ( "Margin LY - empty customer selection is blank", [MARGIN (LY)] ),
		            PQL.Assert.ShouldBeNull ( "Margin YTD - empty customer selection is blank", [MARGIN (YTD)] )
		        ),
		        FILTER ( ALL ( 'Customer'[CustomerKey] ), FALSE () ),
		        TREATAS ( { DATE ( 2019, 6, 30 ) }, 'Calendar'[Date] )
		    )
		)
	lineageTag: ce15773d-5b5a-4708-8f2c-b3ae3575ab40

/// DAX Assertion Library Functions
/// Publisher: PQL (Power Query Lint)
/// These functions provide a standardized way to write unit tests for DAX models
/// Basic Assertions - PQL.Assert namespace
/// Asserts that a condition is TRUE. The BOOLEAN parameter converts BLANK() to FALSE before the function runs, so a BLANK condition fails here and passes ShouldBeFalse. Use ShouldNotBeNull first when the value can be BLANK.
function 'PQL.Assert.ShouldBeTrue' =
		(testName : STRING, actualCondition : BOOLEAN) =>
		    VAR _Passed = actualCondition = TRUE
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "TRUE",
		        "Actual", IF(actualCondition, "TRUE", "FALSE"),
		        "Passed", _Passed
		    )
	lineageTag: 15d834e1-e3c1-4800-8307-da51107a7f28

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a condition is FALSE. The BOOLEAN parameter converts BLANK() to FALSE before the function runs, so a BLANK condition passes. Use ShouldNotBeNull first when the value can be BLANK.
function 'PQL.Assert.ShouldBeFalse' =
		(testName : STRING, actualCondition : BOOLEAN) =>
		    VAR _Passed = actualCondition = FALSE
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "FALSE",
		        "Actual", IF(actualCondition, "TRUE", "FALSE"),
		        "Passed", _Passed
		    )
	lineageTag: d2a7099f-f955-4098-95ab-7b33c0037642

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is NULL (DAX BLANK()).
function 'PQL.Assert.ShouldBeNull' =
		(testName : STRING, actualValue : VARIANT) =>
		    VAR _Passed = ISBLANK(actualValue)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NULL",
		        "Actual", IF(ISBLANK(actualValue), "NULL", IF(EXACT(actualValue, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 5aff047b-652a-4252-8788-56d0929cf3e5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is not NULL (not DAX BLANK()). Accepts both simple values and expressions.
function 'PQL.Assert.ShouldNotBeNull' =
		(testName : STRING, actualValue : SCALAR VARIANT EXPR) =>
		    VAR _ActualResult = actualValue
		    VAR _Passed = NOT ISBLANK(_ActualResult)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NOT NULL",
		        "Actual", IF(ISBLANK(_ActualResult), "NULL", IF(EXACT(_ActualResult, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 9dededf1-c704-44f2-893b-b6b6140af51f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is BLANK (empty string "").
function 'PQL.Assert.ShouldBeBlank' =
		(testName : STRING, actualValue : VARIANT) =>
		    VAR _Passed = NOT ISBLANK(actualValue) && EXACT(actualValue, "")
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "BLANK (empty string)",
		        "Actual", IF(ISBLANK(actualValue), "NULL", IF(EXACT(actualValue, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 7b32192b-212c-431d-8cab-20ee570086d5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is not BLANK (not empty string "").
function 'PQL.Assert.ShouldNotBeBlank' =
		(testName : STRING, actualValue : SCALAR VARIANT EXPR) =>
		    VAR _ActualResult = actualValue
		    VAR _Passed = ISBLANK(_ActualResult) || NOT EXACT(_ActualResult, "")
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NOT BLANK (not empty string)",
		        "Actual", IF(ISBLANK(_ActualResult), "NULL", IF(EXACT(_ActualResult, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 859aee01-e56e-4c70-9ef9-631fd07814f0

