model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["HttpSource","Environment","Calendar","Sales","Product","Customer","Store"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode","CalcGroup","TMDLView_Desktop","DaxQueryView_Desktop","TMDL-Extension","MCP-PBIModeling"]

ref table Calendar
ref table Sales
ref table Product
ref table 'Product (Basket)'
ref table 'Basket Pair'
ref table 'Minimum Support'
ref table 'Minimum Lift'
ref table Customer
ref table Store

ref cultureInfo en-US
