/// Customer dimension, one record per CustomerKey. Geography describes customers, not stores. Customer record counts are not purchasing-customer counts; no loyalty or lifecycle segments are defined.
table Customer
	lineageTag: 04227f5a-0aeb-4448-b5c5-dbf3e276da85

	/// Customer dimension record count, not customers who bought. Use # Customers (w/ Sales) for purchasing customers. Sales-only filters do not reduce this count through single-direction relationships.
	measure '# Customers' = COUNTROWS('Customer')
		formatString: #,##0
		lineageTag: a8dc565a-aa9b-40dc-902c-1ba2596b0977

	column CustomerKey
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 901662ed-f0ae-41f6-96b3-4aa68bad1c7a
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	/// Source customer gender attribute for customer segmentation and sales grouping. Describes the customer record, not a product or store attribute.
	column Gender
		dataType: string
		lineageTag: 7e0ce5eb-3e63-4870-b30a-032f5186375d
		summarizeBy: none
		sourceColumn: Gender

		annotation SummarizationSetBy = Automatic

	/// Customer name on the source record, not a unique relationship key. Use only for authorized customer-level analysis; aggregate purchasing coverage uses # Customers (w/ Sales).
	column Customer
		dataType: string
		lineageTag: 8845f8b5-b069-41a0-8af8-12e402b113e9
		isDefaultLabel
		summarizeBy: none
		sourceColumn: Customer

		annotation SummarizationSetBy = Automatic

	/// Customer address from the source, not a store address. Personal detail not needed for aggregate sales analysis; exclude from the default AI data schema.
	column Address
		dataType: string
		lineageTag: adbeb074-7c67-40ee-be2d-d46775ce5e17
		summarizeBy: none
		sourceColumn: Address

		annotation SummarizationSetBy = Automatic

	/// Customer city from the source, not store location. Use with customer State and Country to disambiguate geography.
	column City
		dataType: string
		lineageTag: a791eb8c-7fab-418d-844a-f8b094453037
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = Automatic

	/// Customer state or region code, not store geography. Use Customer State for readable labels and Country for geographic context.
	column 'State Code'
		dataType: string
		lineageTag: 29de3d16-fffa-4f61-8c39-c1a2a36d737a
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State Code

		annotation SummarizationSetBy = Automatic

	/// Customer state or region label, not store State. Use for customer-residence sales comparisons with Customer Country.
	column State
		dataType: string
		lineageTag: 923b4cc1-6137-4bb4-bcb2-3a90c5f76c5e
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	/// Customer postal code stored as text, not a numeric quantity or store postal code. Personal geographic detail; exclude from the default AI data schema.
	column 'Zip Code'
		dataType: string
		lineageTag: 439ce0ee-437e-4770-90c4-c4d53ebfb35b
		dataCategory: PostalCode
		summarizeBy: none
		sourceColumn: Zip Code

		annotation SummarizationSetBy = Automatic

	/// Source customer country code, distinct from full Customer Country and Store Country. Use Customer Country for business-facing geography.
	column 'Country Code'
		dataType: string
		lineageTag: f3eea279-4255-446b-9f83-f40f66abf6d1
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country Code

		annotation SummarizationSetBy = Automatic

	/// Customer country name, not store country. Use for sales by customer residence; clarify which geography is intended when a question says only country.
	column Country
		dataType: string
		lineageTag: 99af44ae-86e9-4b75-98a3-e4b6e53fe806
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = Automatic

	/// Customer continent from the source for customer-geography grouping. Describes customer location, not a store or sales-channel region.
	column Continent
		dataType: string
		lineageTag: 53b840d2-962c-44c4-8733-6cc003fb9a83
		dataCategory: Continent
		summarizeBy: none
		sourceColumn: Continent

		annotation SummarizationSetBy = Automatic

	/// Source customer birth date, not an order date. Personal detail used to calculate Age at processing; exclude from the default AI data schema.
	column Birthday
		dataType: dateTime
		formatString: Long Date
		lineageTag: afa5e191-c690-45c1-a725-41c9d3ca9434
		summarizeBy: none
		sourceColumn: Birthday

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Year boundaries between Birthday and processing-time TODAY(), not exact completed years of age. Recalculated during processing, not each report view; do not sum ages.
	column Age =
			
			DATEDIFF(
			    [Birthday],
			    TODAY(),
			    YEAR
			)
		formatString: 0
		lineageTag: eedffcae-3881-4d0d-ba45-7a5b19382fca
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Customer-3757b886-e26c-4cec-a550-cdeea37b94d4 = m
		mode: import
		source =
				let
					Source = Csv.Document(
						Web.Contents(HttpSource, [RelativePath = "RAW-Customer.csv"]),
						[
							Delimiter = ",",
							Columns = 13,
							Encoding = 65001,
							QuoteStyle = QuoteStyle.None
						]
					),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					#"Changed Column Types" = Table.TransformColumnTypes(
						#"Promoted Headers",
						{
							{"CustomerKey", Int64.Type},
							{"Gender", type text},
							{"Name", type text},
							{"Address", type text},
							{"City", type text},
							{"State Code", type text},
							{"State", type text},
							{"Zip Code", type text},
							{"Country Code", type text},
							{"Country", type text},
							{"Continent", type text},
							{"Birthday", type date},
							{"Age", Int64.Type}
						}
					),
					#"Renamed Columns" = Table.RenameColumns(#"Changed Column Types", {{"Name", "Customer"}}),
					#"Removed Columns" = Table.RemoveColumns(#"Renamed Columns", {"Age"})
				in
					#"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

