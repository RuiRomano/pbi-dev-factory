/// String Assertions - PQL.Assert namespace
/// Asserts that a string starts with the specified prefix (case-insensitive). A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldStartWith' =
		(testName : STRING, prefix : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && LEFT(UPPER(actual), LEN(prefix)) = UPPER(prefix)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Starts with '" & prefix & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
	lineageTag: 2ed2f5ac-4ca0-42a9-8ae5-774e992fbb9f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a string ends with the specified suffix (case-insensitive). A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldEndWith' =
		(testName : STRING, suffix : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && RIGHT(UPPER(actual), LEN(suffix)) = UPPER(suffix)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Ends with '" & suffix & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
	lineageTag: 7055bc7e-7c20-4cfa-8b74-ca4c529a3989

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a string contains the specified substring (case-insensitive). A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldContainString' =
		(testName : STRING, substring : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && CONTAINSSTRING(actual, substring)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Contains '" & substring & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
	lineageTag: bb2eaee1-f353-4d31-841f-2d9221a3f9b9

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a string contains a pattern (case-insensitive). Uses CONTAINSSTRING: a substring match where ? matches one character and * matches any run of characters. It is not a regular expression and does not need to match the whole value. A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldMatch' =
		(testName : STRING, pattern : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && CONTAINSSTRING(actual, pattern)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Matches '" & pattern & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
	lineageTag: 715c85a1-085d-4a1f-94a6-725f24faeb6b

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Runs all DAX expression best practice checks.
/// This function executes all DAX expression validation rules and returns combined results.
function 'PQL.Assert.BP.CheckDAXExpressions' =
		() =>
		    UNION(
		        PQL.Assert.BP.ShouldUseFullyQualifiedColumnReferences(),
		        PQL.Assert.BP.ShouldUseTreatAsInsteadOfIntersect()
		    )
	lineageTag: 89923e07-d106-41d0-b80d-8cd86c05c138

