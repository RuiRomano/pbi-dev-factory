function 'PQL.Assert.ShouldEqual' =
		(testName : STRING, expected : VARIANT, actual : VARIANT) =>
		    VAR _ExpType = SWITCH(TRUE(), ISBLANK(expected), 0, ISLOGICAL(expected), 1, ISTEXT(expected), 2, ISNUMBER(expected), 3, 4)
		    VAR _ActType = SWITCH(TRUE(), ISBLANK(actual), 0, ISLOGICAL(actual), 1, ISTEXT(actual), 2, ISNUMBER(actual), 3, 4)
		    VAR _Passed = _ExpType = _ActType && FORMAT(expected, "") = FORMAT(actual, "")
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", FORMAT(expected, ""),
		        "Actual", FORMAT(actual, ""),
		        "Passed", _Passed
		    )
	lineageTag: f8614f10-40e8-4588-af6b-545d4c5e5579

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

function 'PQL.Assert.ShouldNotEqual' =
		(testName : STRING, notExpected : VARIANT, actual : VARIANT) =>
		    VAR _ExpType = SWITCH(TRUE(), ISBLANK(notExpected), 0, ISLOGICAL(notExpected), 1, ISTEXT(notExpected), 2, ISNUMBER(notExpected), 3, 4)
		    VAR _ActType = SWITCH(TRUE(), ISBLANK(actual), 0, ISLOGICAL(actual), 1, ISTEXT(actual), 2, ISNUMBER(actual), 3, 4)
		    VAR _Passed = NOT(_ExpType = _ActType && FORMAT(notExpected, "") = FORMAT(actual, ""))
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NOT " & FORMAT(notExpected, ""),
		        "Actual", FORMAT(actual, ""),
		        "Passed", _Passed
		    )
	lineageTag: fc53e9df-cdfd-44d3-938e-d9899b93c129

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that two strings are exactly equal (case-sensitive comparison). NULL (BLANK()) equals only NULL, not "", like ShouldEqual (changed in 0.8.0; 0.7.x treated NULL as "").
function 'PQL.Assert.ShouldEqualExactly' =
		(testName : STRING, expected : STRING, actual : STRING) =>
		    VAR _Passed = IF(ISBLANK(expected) || ISBLANK(actual), ISBLANK(expected) && ISBLANK(actual), EXACT(expected, actual))
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", IF(ISBLANK(expected), "NULL", expected),
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
	lineageTag: 36131393-ab7d-42ed-8339-4f8d8a77bf88

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a number is greater than a threshold. A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as 0).
function 'PQL.Assert.ShouldBeGreaterThan' =
		(testName : STRING, threshold : DOUBLE, actual : DOUBLE) =>
		    VAR _Passed = NOT ISBLANK(actual) && actual > threshold
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "> " & FORMAT(threshold, ""),
		        "Actual", IF(ISBLANK(actual), "NULL", FORMAT(actual, "")),
		        "Passed", _Passed
		    )
	lineageTag: 6c0bb20d-ab5f-4bd4-81d8-c60aa96dacfa

