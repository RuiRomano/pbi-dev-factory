/// Asserts that a number is within an inclusive range. A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as 0).
function 'PQL.Assert.ShouldBeBetween' =
		(testName : STRING, lowerBound : DOUBLE, upperBound : DOUBLE, actual : DOUBLE) =>
		    VAR _Passed = NOT ISBLANK(actual) && actual >= lowerBound && actual <= upperBound
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", FORMAT(lowerBound, "") & " <= value <= " & FORMAT(upperBound, ""),
		        "Actual", IF(ISBLANK(actual), "NULL", FORMAT(actual, "")),
		        "Passed", _Passed
		    )
	lineageTag: 37872374-a8a1-435a-8346-4af6024d8733

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is outside an inclusive range: actual < lowerBound or actual > upperBound. Argument order matches ShouldBeBetween. A NULL (BLANK()) actual value fails.
function 'PQL.Assert.ShouldNotBeBetween' =
		(testName : STRING, lowerBound : DOUBLE, upperBound : DOUBLE, actual : DOUBLE) =>
		    VAR _Passed = NOT ISBLANK(actual) && (actual < lowerBound || actual > upperBound)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NOT " & FORMAT(lowerBound, "General Number") & " <= value <= " & FORMAT(upperBound, "General Number"),
		        "Actual", IF(ISBLANK(actual), "NULL", FORMAT(actual, "General Number")),
		        "Passed", _Passed
		    )
	lineageTag: 5b4b9c5c-0ffc-4505-a842-af050a621023

