/// Table Assertions - PQL.Assert.Tbl namespace
/// Table-level assertion functions for schema and structure validation
/// Publisher: PQL (Power Query Lint)
/// Asserts that a table has at least one row.
function 'PQL.Assert.Tbl.ShouldHaveRows' =
		(testName : STRING, tableRef : TABLE EXPR) =>
			VAR _RowCount = COUNTROWS(tableRef)
			VAR _Passed = _RowCount > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table has rows",
				"Actual", IF(_Passed, "HAS ROWS (" & FORMAT(_RowCount, "0") & ")", "EMPTY (0 rows)"),
				"Passed", _Passed
			)
	lineageTag: 49068057-9dc6-4c27-8a80-78094393071f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Resolves Product A from its normal dimension, intersecting an observed overview pair only when that disconnected pair table is filtered.
function 'Basket.KeysA' =
		() =>
		    VAR v_pairKeys = VALUES ( 'Basket Pair'[Product A Key] )
		    RETURN
		        FILTER (
		            VALUES ( 'Product'[ProductKey] ),
		            NOT ISFILTERED ( 'Basket Pair' ) || 'Product'[ProductKey] IN v_pairKeys
		        )

/// Resolves Product B independently, intersecting an observed overview pair only when its disconnected pair table is filtered.
function 'Basket.KeysB' =
		() =>
		    VAR v_pairKeys = VALUES ( 'Basket Pair'[Product B Key] )
		    RETURN
		        FILTER (
		            VALUES ( 'Product (Basket)'[ProductKey] ),
		            NOT ISFILTERED ( 'Basket Pair' ) || 'Product (Basket)'[ProductKey] IN v_pairKeys
		        )

/// Independent qualifying order set for one product role. Product selections are captured before clearing both role tables. Positive Quantity and nonblank Order Number are the complete approved line rule.
function 'Basket.Orders' =
		(productKeys : TABLE VAL) =>
		    CALCULATETABLE (
		        VALUES ( 'Sales'[Order Number] ),
		        REMOVEFILTERS ( 'Product' ),
		        REMOVEFILTERS ( 'Product (Basket)' ),
		        REMOVEFILTERS ( 'Sales'[ProductKey] ),
		        TREATAS ( productKeys, 'Sales'[ProductKey] ),
		        KEEPFILTERS ( 'Sales'[Quantity] > 0 ),
		        KEEPFILTERS ( NOT ISBLANK ( 'Sales'[Order Number] ) )
		    )

/// Validates equal active grain for directional A/B pairs; suppresses self pairs, blank members and ambiguous totals. Product identity uses ProductKey rather than potentially repeated labels.
function 'Basket.IsValidPair' =
		() =>
		    VAR v_grain =
		        SWITCH (
		            TRUE (),
		            ISINSCOPE ( 'Product'[Product] ) || ISINSCOPE ( 'Product (Basket)'[Product] ), 3,
		            ISINSCOPE ( 'Product'[Subcategory] ) || ISINSCOPE ( 'Product (Basket)'[Subcategory] ), 2,
		            ISINSCOPE ( 'Product'[Category] ) || ISINSCOPE ( 'Product (Basket)'[Category] ), 1,
		            ISFILTERED ( 'Product'[Product] ) || ISFILTERED ( 'Product'[ProductKey] )
		                || ISFILTERED ( 'Product (Basket)'[Product] ) || ISFILTERED ( 'Product (Basket)'[ProductKey] ), 3,
		            ISFILTERED ( 'Product'[Subcategory] ) || ISFILTERED ( 'Product (Basket)'[Subcategory] ), 2,
		            1
		        )
		    VAR v_keysA = Basket.KeysA ()
		    VAR v_keysB = Basket.KeysB ()
		    VAR v_pairTableValid =
		        COUNTROWS ( v_keysA ) == 1
		            && COUNTROWS ( v_keysB ) == 1
		            && NOT ISBLANK ( MAXX ( v_keysA, 'Product'[ProductKey] ) )
		            && NOT ISBLANK ( MAXX ( v_keysB, 'Product (Basket)'[ProductKey] ) )
		            && MAXX ( v_keysA, 'Product'[ProductKey] ) <> MAXX ( v_keysB, 'Product (Basket)'[ProductKey] )
		    RETURN
		        IF ( ISFILTERED ( 'Basket Pair' ), v_pairTableValid, SWITCH (
		            v_grain,
		            3, HASONEVALUE ( 'Product'[ProductKey] )
		                && HASONEVALUE ( 'Product (Basket)'[ProductKey] )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product'[ProductKey] ) )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product (Basket)'[ProductKey] ) )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product'[Product] ) )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product (Basket)'[Product] ) )
		                && SELECTEDVALUE ( 'Product'[ProductKey] ) <> SELECTEDVALUE ( 'Product (Basket)'[ProductKey] ),
		            2, HASONEVALUE ( 'Product'[Subcategory] )
		                && HASONEVALUE ( 'Product (Basket)'[Subcategory] )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product'[Subcategory] ) )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product (Basket)'[Subcategory] ) )
		                && SELECTEDVALUE ( 'Product'[Subcategory] ) <> SELECTEDVALUE ( 'Product (Basket)'[Subcategory] ),
		            1, HASONEVALUE ( 'Product'[Category] )
		                && HASONEVALUE ( 'Product (Basket)'[Category] )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product'[Category] ) )
		                && NOT ISBLANK ( SELECTEDVALUE ( 'Product (Basket)'[Category] ) )
		                && SELECTEDVALUE ( 'Product'[Category] ) <> SELECTEDVALUE ( 'Product (Basket)'[Category] )
		        ) )

function 'Tests.Run' =
		() =>
		UNION (
		    Tests.MarketBasket (),
		    PQL.Assert.Tbl.ShouldHaveRows ( "Sales should have rows", 'Sales' ),
		    PQL.Assert.Tbl.ShouldHaveRows ( "Customer should have rows", 'Customer' ),
			// Tests [# New Customers]
		    VAR actual =
		        CALCULATE (
		            [# New Customers],
		            TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		            TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		            TREATAS ( { "Southridge Video" }, 'Product'[Brand] ),
		            TREATAS ( { DATE ( 2017, 6, 27 ) }, 'Calendar'[Date] )
		        )
		    RETURN
		        PQL.Assert.ShouldEqual ( "1 brand - positive: first purchase", 1, actual ),
		    VAR actual =
		        COALESCE (
		            CALCULATE (
		                [# New Customers],
		                TREATAS ( { 357592 }, 'Customer'[CustomerKey] ),
		                TREATAS ( { "Cell phones" }, 'Product'[Category] ),
		                TREATAS ( { "Contoso" }, 'Product'[Brand] ),
		                TREATAS ( { DATE ( 2019, 12, 25 ) }, 'Calendar'[Date] )
		            ),
		            0
		        )
		    RETURN
		        PQL.Assert.ShouldEqual ( "1 brand - negative: repeat purchase is not new", 0, actual ),
		    CALCULATETABLE (
		        PQL.Assert.ShouldEqual ( "Returning - first purchase returns zero", 0, [# Returning Customers] ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Southridge Video" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2017, 6, 27 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - repeat purchase", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "Returning - repeat fixture has current sales", 1, [# Customers (w/ Sales)] ),
		            PQL.Assert.ShouldEqual ( "Returning - repeat fixture has earlier purchase", DATE ( 2017, 11, 8 ), CALCULATE ( MIN ( 'Sales'[Order Date] ), REMOVEFILTERS ( 'Calendar' ) ) )
		        ),
		        TREATAS ( { 357592 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Cell phones" }, 'Product'[Category] ),
		        TREATAS ( { "Contoso" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 25 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - earlier selected brand", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - earlier selected brand excludes new", 0, COALESCE ( [# New Customers], 0 ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Southridge Video", "Tailspin Toys" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - excluded brand and category do not qualify", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - excluded brand and category preserve new", 1, [# New Customers] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Tailspin Toys", "Contoso" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - earlier purchase in excluded brand", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - earlier purchase in excluded brand", 1, [# New Customers] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Games and Toys" }, 'Product'[Category] ),
		        TREATAS ( { "Tailspin Toys" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - earlier selected category qualifies", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - earlier selected category excludes new", 0, COALESCE ( [# New Customers], 0 ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { "Tailspin Toys", "Contoso" }, 'Product'[Brand] ),
		        TREATAS ( { DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - same-day first purchase is new only", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - same-day rows count once", 1, [# New Customers] ),
		            PQL.Assert.ShouldEqual ( "Customers - same-day rows count once", 1, [# Customers (w/ Sales)] ),
		            PQL.Assert.ShouldEqual ( "Returning - same-day fixture has multiple rows", 3, COUNTROWS ( 'Sales' ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2017, 6, 27 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - multiple repeat rows count once", 1, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - multiple repeat rows are not new", 0, COALESCE ( [# New Customers], 0 ) ),
		            PQL.Assert.ShouldEqual ( "Returning - multiple repeat fixture has two rows", 2, COUNTROWS ( 'Sales' ) )
		        ),
		        TREATAS ( { 215446 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2018, 6, 25 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - first and later purchases in period", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - first and later purchases in period", 1, [# New Customers] ),
		            PQL.Assert.ShouldEqual ( "Customers - first and later purchases count once", 1, [# Customers (w/ Sales)] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        DATESBETWEEN ( 'Calendar'[Date], DATE ( 2017, 6, 27 ), DATE ( 2019, 12, 4 ) )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldEqual ( "Returning - noncontiguous total recalculates", 0, [# Returning Customers] ),
		            PQL.Assert.ShouldEqual ( "New - noncontiguous total counts customer once", 1, [# New Customers] ),
		            PQL.Assert.ShouldEqual ( "Returning - daily sum differs from period total", 1, SUMX ( VALUES ( 'Calendar'[Date] ), [# Returning Customers] ) ),
		            VAR results =
		                SUMMARIZECOLUMNS (
		                    ROLLUPADDISSUBTOTAL ( 'Calendar'[Date], "IsTotal" ),
		                    "Customers", [# Customers (w/ Sales)],
		                    "New", [# New Customers],
		                    "Returning", [# Returning Customers]
		                )
		            RETURN
		                PQL.Assert.ShouldBeTrue ( "Returning - noncontiguous rows and total reconcile", COUNTROWS ( results ) = 3 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2017, 6, 27 ), DATE ( 2019, 12, 4 ) }, 'Calendar'[Date] )
		    ),
		    CALCULATETABLE (
		        UNION (
		            PQL.Assert.ShouldBeNull ( "Returning - no sales returns blank", [# Returning Customers] ),
		            PQL.Assert.ShouldBeNull ( "Customers - no sales fixture", [# Customers (w/ Sales)] )
		        ),
		        TREATAS ( { 102075 }, 'Customer'[CustomerKey] ),
		        TREATAS ( { DATE ( 2017, 1, 1 ) }, 'Calendar'[Date] )
		    ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( 'Calendar'[Date], "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - date rows and grand total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( 'Calendar'[Year-Month], "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - month rows and grand total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( 'Customer'[CustomerKey], "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - customer rows and grand total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) ),
		    VAR results =
		        SUMMARIZECOLUMNS (
		            ROLLUPADDISSUBTOTAL ( ROLLUPGROUP ( 'Product'[Category], 'Product'[Brand] ), "IsTotal" ),
		            "Customers", [# Customers (w/ Sales)],
		            "New", [# New Customers],
		            "Returning", [# Returning Customers]
		        )
		    RETURN
		        PQL.Assert.ShouldBeTrue ( "Returning - category brand rows and total reconcile", COUNTROWS ( results ) > 1 && ISEMPTY ( FILTER ( results, NOT ( [Customers] == [New] + [Returning] ) ) ) )
		)
	lineageTag: ce15773d-5b5a-4708-8f2c-b3ae3575ab40

/// Independent order/product projection used only by MBA assertions. Does not call the production basket-set function. Caller Date, Customer, Store and remaining nonproduct filters are retained.
function 'Tests.BasketPair' =
		(keyA : INT64, keyB : INT64, testScope : STRING) =>
		    VAR v_lines =
		        CALCULATETABLE (
		            SELECTCOLUMNS (
		                FILTER ( 'Sales', 'Sales'[Quantity] > 0 && NOT ISBLANK ( 'Sales'[Order Number] ) ),
		                "@Order", 'Sales'[Order Number],
		                "@Product", 'Sales'[ProductKey],
		                "@Units", 'Sales'[Quantity]
		            ),
		            REMOVEFILTERS ( 'Product' ),
		            REMOVEFILTERS ( 'Product (Basket)' ),
		            REMOVEFILTERS ( 'Sales'[ProductKey] )
		        )
		    VAR v_orders = DISTINCT ( SELECTCOLUMNS ( v_lines, "@Order", [@Order] ) )
		    VAR v_a = DISTINCT ( SELECTCOLUMNS ( FILTER ( v_lines, [@Product] = keyA ), "@Order", [@Order] ) )
		    VAR v_b = DISTINCT ( SELECTCOLUMNS ( FILTER ( v_lines, [@Product] = keyB ), "@Order", [@Order] ) )
		    VAR v_joint =
		        FILTER (
		            v_orders,
		            VAR v_order = [@Order]
		            RETURN
		                COUNTROWS ( FILTER ( v_a, [@Order] = v_order ) ) > 0
		                    && COUNTROWS ( FILTER ( v_b, [@Order] = v_order ) ) > 0
		        )
		    VAR v_total = COUNTROWS ( v_orders )
		    VAR v_countA = COALESCE ( COUNTROWS ( v_a ), 0 )
		    VAR v_countB = COALESCE ( COUNTROWS ( v_b ), 0 )
		    VAR v_countJoint = COALESCE ( COUNTROWS ( v_joint ), 0 )
		    VAR v_support = DIVIDE ( v_countJoint, v_total )
		    VAR v_confidence = DIVIDE ( v_countJoint, v_countA )
		    VAR v_lift = DIVIDE ( v_countJoint * v_total, v_countA * v_countB )
		    VAR v_distinctProducts = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( v_lines, "@Order", [@Order], "@Product", [@Product] ) ) )
		    VAR v_units = SUMX ( v_lines, [@Units] )
		    VAR v_sample = TOPN ( 100, v_joint, [@Order], ASC )
		    VAR v_label = "MBA " & testScope & " [" & keyA & " -> " & keyB & "] "
		    RETURN
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( v_label & "TOTAL ORDERS", v_total, [TOTAL ORDERS] ),
		                PQL.Assert.ShouldEqual ( v_label & "ORDERS WITH A", v_countA, [ORDERS WITH A] ),
		                PQL.Assert.ShouldEqual ( v_label & "ORDERS WITH B independent of A", v_countB, [ORDERS WITH B] ),
		                PQL.Assert.ShouldEqual ( v_label & "ORDERS WITH A AND B distinct orders", v_countJoint, [ORDERS WITH A AND B] ),
		                PQL.Assert.ShouldEqual ( v_label & "SUPPORT", v_support, [SUPPORT] ),
		                PQL.Assert.ShouldEqual ( v_label & "CONFIDENCE", v_confidence, [CONFIDENCE] ),
		                PQL.Assert.ShouldBeTrue (
		                    v_label & "LIFT independent formula",
		                    ISBLANK ( v_lift ) == ISBLANK ( [LIFT] )
		                        && ( ISBLANK ( v_lift ) || ABS ( v_lift - [LIFT] ) <= 0.000000001 )
		                ),
		                PQL.Assert.ShouldEqual ( v_label & "AVG BASKET SIZE", DIVIDE ( v_distinctProducts, v_total ), [AVG BASKET SIZE] ),
		                PQL.Assert.ShouldEqual ( v_label & "AVG ITEMS PER ORDER", DIVIDE ( v_units, v_total ), [AVG ITEMS PER ORDER] ),
		                PQL.Assert.ShouldEqual (
		                    v_label & "PAIR ELIGIBLE at inclusive zero thresholds",
		                    IF ( v_countJoint > 0 && NOT ISBLANK ( v_support ) && NOT ISBLANK ( v_lift ), 1 ),
		                    CALCULATE ( [PAIR ELIGIBLE], TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ), TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] ) )
		                ),
		                PQL.Assert.ShouldEqual (
		                    v_label & "ORDER IN PAIR SAMPLE exact first100 intersection",
		                    COUNTROWS ( v_sample ),
		                    COUNTROWS (
		                        FILTER (
		                            v_orders,
		                            VAR v_order = [@Order]
		                            RETURN
		                                CALCULATE ( [ORDER IN PAIR SAMPLE], TREATAS ( { v_order }, 'Sales'[Order Number] ) ) == 1
		                        )
		                    )
		                ),
		                PQL.Assert.ShouldBeTrue (
		                    v_label & "ORDER IN PAIR SAMPLE excludes nonmembers",
		                    ISEMPTY (
		                        FILTER (
		                            v_orders,
		                            VAR v_order = [@Order]
		                            VAR v_expected = COUNTROWS ( FILTER ( v_sample, [@Order] = v_order ) ) > 0
		                            VAR v_actual = CALCULATE ( [ORDER IN PAIR SAMPLE], TREATAS ( { v_order }, 'Sales'[Order Number] ) ) == 1
		                            RETURN v_expected <> v_actual
		                        )
		                    )
		                ),
		                CALCULATETABLE (
		                    UNION (
		                        PQL.Assert.ShouldEqual ( v_label & "reverse SUPPORT", v_support, [SUPPORT] ),
		                        PQL.Assert.ShouldEqual ( v_label & "reverse directional CONFIDENCE", DIVIDE ( v_countJoint, v_countB ), [CONFIDENCE] ),
		                        PQL.Assert.ShouldBeTrue (
		                            v_label & "reverse LIFT",
		                            ISBLANK ( v_lift ) == ISBLANK ( [LIFT] )
		                                && ( ISBLANK ( v_lift ) || ABS ( v_lift - [LIFT] ) <= 0.000000001 )
		                        )
		                    ),
		                    TREATAS ( { keyB }, 'Product'[ProductKey] ),
		                    TREATAS ( { keyA }, 'Product (Basket)'[ProductKey] )
		                )
		            ),
		            TREATAS ( { keyA }, 'Product'[ProductKey] ),
		            TREATAS ( { keyB }, 'Product (Basket)'[ProductKey] )
		        )

/// Independent group-grain reference; applies the two current role selections to separate line projections rather than using the production order-set function.
function 'Tests.BasketGroupContext' =
		(testScope : STRING) =>
		    VAR v_keysA = VALUES ( 'Product'[ProductKey] )
		    VAR v_keysB = VALUES ( 'Product (Basket)'[ProductKey] )
		    VAR v_lines =
		        CALCULATETABLE (
		            FILTER ( 'Sales', 'Sales'[Quantity] > 0 && NOT ISBLANK ( 'Sales'[Order Number] ) ),
		            REMOVEFILTERS ( 'Product' ),
		            REMOVEFILTERS ( 'Product (Basket)' ),
		            REMOVEFILTERS ( 'Sales'[ProductKey] )
		        )
		    VAR v_all = DISTINCT ( SELECTCOLUMNS ( v_lines, "@Order", 'Sales'[Order Number] ) )
		    VAR v_a = DISTINCT ( SELECTCOLUMNS ( FILTER ( v_lines, 'Sales'[ProductKey] IN v_keysA ), "@Order", 'Sales'[Order Number] ) )
		    VAR v_b = DISTINCT ( SELECTCOLUMNS ( FILTER ( v_lines, 'Sales'[ProductKey] IN v_keysB ), "@Order", 'Sales'[Order Number] ) )
		    VAR v_joint =
		        COUNTROWS (
		            FILTER (
		                v_all,
		                VAR v_order = [@Order]
		                RETURN
		                    COUNTROWS ( FILTER ( v_a, [@Order] = v_order ) ) > 0
		                        && COUNTROWS ( FILTER ( v_b, [@Order] = v_order ) ) > 0
		            )
		        )
		    VAR v_total = COUNTROWS ( v_all )
		    VAR v_countA = COALESCE ( COUNTROWS ( v_a ), 0 )
		    VAR v_countB = COALESCE ( COUNTROWS ( v_b ), 0 )
		    VAR v_countJoint = COALESCE ( v_joint, 0 )
		    VAR v_lift = DIVIDE ( v_countJoint * v_total, v_countA * v_countB )
		    RETURN
		        UNION (
		            PQL.Assert.ShouldEqual ( "MBA " & testScope & " total", v_total, [TOTAL ORDERS] ),
		            PQL.Assert.ShouldEqual ( "MBA " & testScope & " A orders", v_countA, [ORDERS WITH A] ),
		            PQL.Assert.ShouldEqual ( "MBA " & testScope & " B orders", v_countB, [ORDERS WITH B] ),
		            PQL.Assert.ShouldEqual ( "MBA " & testScope & " joint", v_countJoint, [ORDERS WITH A AND B] ),
		            PQL.Assert.ShouldEqual ( "MBA " & testScope & " support", DIVIDE ( v_countJoint, v_total ), [SUPPORT] ),
		            PQL.Assert.ShouldEqual ( "MBA " & testScope & " confidence", DIVIDE ( v_countJoint, v_countA ), [CONFIDENCE] ),
		            PQL.Assert.ShouldBeTrue ( "MBA " & testScope & " lift", ISBLANK ( v_lift ) == ISBLANK ( [LIFT] ) && ( ISBLANK ( v_lift ) || ABS ( v_lift - [LIFT] ) <= 0.000000001 ) )
		        )

/// MBA regression suite. Three real product pairs were discovered on live orders 269500, 269504 and 269703. Expected values are independently recomputed from qualifying lines, never hard-coded from the measures being tested.
function 'Tests.MarketBasket' =
		() =>
		    UNION (
		        Tests.BasketPair ( 18, 444, "all history Contoso MP3 / WWI desktop" ),
		        Tests.BasketPair ( 113, 1577, "all history WWI headphones / SV recorder" ),
		        Tests.BasketPair ( 216, 648, "all history Litware theater / Proseware fax" ),
		        VAR v_referencePairs =
		            DISTINCT (
		                SELECTCOLUMNS (
		                    GENERATE (
		                        CALCULATETABLE (
		                            VALUES ( 'Sales'[Order Number] ),
		                            'Sales'[Quantity] > 0,
		                            NOT ISBLANK ( 'Sales'[Order Number] )
		                        ),
		                        VAR v_products =
		                            CALCULATETABLE ( VALUES ( 'Sales'[ProductKey] ), 'Sales'[Quantity] > 0 )
		                        RETURN
		                            FILTER (
		                                CROSSJOIN (
		                                    SELECTCOLUMNS ( v_products, "@A", 'Sales'[ProductKey] ),
		                                    SELECTCOLUMNS ( v_products, "@B", 'Sales'[ProductKey] )
		                                ),
		                                [@A] <> [@B]
		                                    && NOT ISBLANK ( LOOKUPVALUE ( 'Product'[Product], 'Product'[ProductKey], [@A] ) )
		                                    && NOT ISBLANK ( LOOKUPVALUE ( 'Product'[Product], 'Product'[ProductKey], [@B] ) )
		                            )
		                    ),
		                    "@A", [@A],
		                    "@B", [@B]
		                )
		            )
		        VAR v_candidates =
		            SELECTCOLUMNS (
		                'Basket Pair',
		                "@A", 'Basket Pair'[Product A Key],
		                "@B", 'Basket Pair'[Product B Key]
		            )
		        RETURN
		            UNION (
		                PQL.Assert.ShouldBeTrue (
		                    "MBA refreshed candidate identities exactly match positive-line same-order pairs",
		                    ISEMPTY ( EXCEPT ( v_referencePairs, v_candidates ) )
		                        && ISEMPTY ( EXCEPT ( v_candidates, v_referencePairs ) )
		                ),
		                PQL.Assert.ShouldEqual (
		                    "MBA observed pair labels uniquely identify key pairs",
		                    COUNTROWS ( 'Basket Pair' ),
		                    COUNTROWS ( SUMMARIZE ( 'Basket Pair', 'Basket Pair'[Product A], 'Basket Pair'[Product B] ) )
		                )
		            ),
		        CALCULATETABLE (
		            VAR v_ranked =
		                FILTER (
		                    SUMMARIZECOLUMNS (
		                        'Basket Pair'[Product A Key],
		                        'Basket Pair'[Product B Key],
		                        "@Rank", [PAIR RANK]
		                    ),
		                    NOT ISBLANK ( [@Rank] ) && [@Rank] <= 20
		                )
		            RETURN
		                UNION (
		                    PQL.Assert.ShouldEqual ( "MBA global top20 has exactly twenty observed pair identities", 20, COUNTROWS ( v_ranked ) ),
		                    PQL.Assert.ShouldEqual ( "MBA global top20 begins at ordinal one", 1, MINX ( v_ranked, [@Rank] ) ),
		                    PQL.Assert.ShouldEqual ( "MBA global top20 ends at ordinal twenty", 20, MAXX ( v_ranked, [@Rank] ) ),
		                    PQL.Assert.ShouldEqual ( "MBA global top20 ordinal ties cannot expand the bound", 20, COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( v_ranked, "@Rank", [@Rank] ) ) ) )
		                ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldBeNull ( "MBA observed historical pair rank respects current Country State", [PAIR RANK] ),
		            TREATAS ( { 18 }, 'Basket Pair'[Product A Key] ),
		            TREATAS ( { 444 }, 'Basket Pair'[Product B Key] ),
		            TREATAS ( { "United States" }, 'Store'[Country] ),
		            TREATAS ( { "South Carolina" }, 'Store'[State] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldBeNull ( "MBA observed historical pair rank respects current Date", [PAIR RANK] ),
		            TREATAS ( { 18 }, 'Basket Pair'[Product A Key] ),
		            TREATAS ( { 444 }, 'Basket Pair'[Product B Key] ),
		            TREATAS ( { DATE ( 2017, 5, 19 ) }, 'Calendar'[Date] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA ORDER SAMPLE DATE current order date", DATE ( 2017, 5, 18 ), [ORDER SAMPLE DATE] ),
		                PQL.Assert.ShouldEqual ( "MBA ORDER SAMPLE STORE current order store", LOOKUPVALUE ( 'Store'[Store], 'Store'[StoreKey], 999999 ), [ORDER SAMPLE STORE] )
		            ),
		            TREATAS ( { 269500 }, 'Sales'[Order Number] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldBeNull ( "MBA ORDER SAMPLE DATE excludes nonmember", [ORDER SAMPLE DATE] ),
		                PQL.Assert.ShouldBeNull ( "MBA ORDER SAMPLE STORE excludes nonmember", [ORDER SAMPLE STORE] )
		            ),
		            TREATAS ( { 269504 }, 'Sales'[Order Number] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        CALCULATETABLE (
		            VAR v_displayed =
		                FILTER (
		                    SUMMARIZECOLUMNS (
		                        'Sales'[Order Number],
		                        "@Date", [ORDER SAMPLE DATE],
		                        "@Store", [ORDER SAMPLE STORE],
		                        "@InSample", [ORDER IN PAIR SAMPLE]
		                    ),
		                    [@InSample] == 1
		                )
		            RETURN
		                UNION (
		                    PQL.Assert.ShouldBeTrue ( "MBA complete displayed detail table globally capped at 100", COUNTROWS ( v_displayed ) <= 100 ),
		                    PQL.Assert.ShouldEqual ( "MBA displayed detail table retains known joint order", 1, COUNTROWS ( FILTER ( v_displayed, 'Sales'[Order Number] = 269500 ) ) )
		                ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldEqual ( "MBA ELIGIBLE LIFT includes qualifying cell unchanged", [LIFT], [ELIGIBLE LIFT] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldBeNull ( "MBA ELIGIBLE LIFT hides below-threshold cell", [ELIGIBLE LIFT] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] ),
		            TREATAS ( { 1 }, 'Minimum Support'[Minimum Support] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldBeNull ( "MBA ELIGIBLE LIFT hides self cell", [ELIGIBLE LIFT] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 18 }, 'Product (Basket)'[ProductKey] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            Tests.BasketPair ( 18, 444, "Country United States State South Carolina" ),
		            TREATAS ( { "United States" }, 'Store'[Country] ),
		            TREATAS ( { "South Carolina" }, 'Store'[State] )
		        ),
		        VAR v_categoryA = LOOKUPVALUE ( 'Product'[Category], 'Product'[ProductKey], 18 )
		        RETURN
		            CALCULATETABLE (
		                PQL.Assert.ShouldBeNull ( "MBA mixed Category A and Product B grain is invalid", [LIFT] ),
		                TREATAS ( { v_categoryA }, 'Product'[Category] ),
		                TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		            ),
		        VAR v_matrix =
		            SUMMARIZECOLUMNS (
		                ROLLUPADDISSUBTOTAL ( 'Product'[Category], "@ATotal" ),
		                ROLLUPADDISSUBTOTAL ( 'Product (Basket)'[Category], "@BTotal" ),
		                "@Lift", [LIFT],
		                "@Keep", 1
		            )
		        RETURN
		            PQL.Assert.ShouldBeTrue (
		                "MBA matrix Category row column and grand totals blank",
		                COUNTROWS ( FILTER ( v_matrix, [@ATotal] || [@BTotal] ) ) > 0
		                    && ISEMPTY ( FILTER ( v_matrix, ( [@ATotal] || [@BTotal] ) && NOT ISBLANK ( [@Lift] ) ) )
		            ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA no joint pair raw SUPPORT remains zero", 0, [SUPPORT] ),
		                PQL.Assert.ShouldEqual ( "MBA no joint pair raw CONFIDENCE remains zero", 0, [CONFIDENCE] ),
		                PQL.Assert.ShouldEqual ( "MBA no joint pair raw LIFT remains zero", 0, [LIFT] ),
		                PQL.Assert.ShouldBeNull ( "MBA zero thresholds exclude never co-purchased pair", [PAIR ELIGIBLE] )
		            ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 1577 }, 'Product (Basket)'[ProductKey] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        PQL.Assert.Tbl.ShouldHaveRows ( "MBA observed Basket Pair candidates exist", 'Basket Pair' ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA observed pair A count", 2, [ORDERS WITH A] ),
		                PQL.Assert.ShouldEqual ( "MBA observed pair B count", 9, [ORDERS WITH B] ),
		                PQL.Assert.ShouldEqual ( "MBA observed pair joint count", 1, [ORDERS WITH A AND B] ),
		                PQL.Assert.ShouldEqual ( "MBA PAIR RANK one selected observed pair", 1, [PAIR RANK] )
		            ),
		            TREATAS ( { 18 }, 'Basket Pair'[Product A Key] ),
		            TREATAS ( { 444 }, 'Basket Pair'[Product B Key] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldBeNull ( "MBA PAIR RANK excludes ineligible observed pair", [PAIR RANK] ),
		            TREATAS ( { 18 }, 'Basket Pair'[Product A Key] ),
		            TREATAS ( { 444 }, 'Basket Pair'[Product B Key] ),
		            TREATAS ( { 1 }, 'Minimum Support'[Minimum Support] )
		        ),
		        CALCULATETABLE (
		            VAR v_ranked =
		                SUMMARIZECOLUMNS (
		                    'Basket Pair'[Product A Key],
		                    'Basket Pair'[Product B Key],
		                    "@Rank", [PAIR RANK]
		                )
		            RETURN
		                UNION (
		                    PQL.Assert.ShouldEqual ( "MBA PAIR RANK tied reverse pairs both present", 2, COUNTROWS ( v_ranked ) ),
		                    PQL.Assert.ShouldEqual ( "MBA PAIR RANK tie breaks lower A key first", 1, MAXX ( FILTER ( v_ranked, 'Basket Pair'[Product A Key] = 18 ), [@Rank] ) ),
		                    PQL.Assert.ShouldEqual ( "MBA PAIR RANK unique global ordinal across A", 2, MAXX ( FILTER ( v_ranked, 'Basket Pair'[Product A Key] = 444 ), [@Rank] ) )
		                ),
		            TREATAS ( { 18, 444 }, 'Basket Pair'[Product A Key] ),
		            TREATAS ( { 18, 444 }, 'Basket Pair'[Product B Key] ),
		            TREATAS ( { 0 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        PQL.Assert.ShouldEqual (
		            "MBA basket key uniquely identifies customer date store",
		            0,
		            COALESCE (
		                COUNTROWS (
		                    FILTER (
		                        SUMMARIZECOLUMNS (
		                            'Sales'[Order Number],
		                            "@Customers", DISTINCTCOUNT ( 'Sales'[CustomerKey] ),
		                            "@Dates", DISTINCTCOUNT ( 'Sales'[Order Date] ),
		                            "@Stores", DISTINCTCOUNT ( 'Sales'[StoreKey] )
		                        ),
		                        [@Customers] > 1 || [@Dates] > 1 || [@Stores] > 1
		                    )
		                ),
		                0
		            )
		        ),
		        VAR v_categoryA = LOOKUPVALUE ( 'Product'[Category], 'Product'[ProductKey], 18 )
		        VAR v_categoryB = LOOKUPVALUE ( 'Product'[Category], 'Product'[ProductKey], 444 )
		        VAR v_subcategoryA = LOOKUPVALUE ( 'Product'[Subcategory], 'Product'[ProductKey], 18 )
		        VAR v_subcategoryB = LOOKUPVALUE ( 'Product'[Subcategory], 'Product'[ProductKey], 444 )
		        RETURN
		            UNION (
		                CALCULATETABLE (
		                    Tests.BasketGroupContext ( "Category all history" ),
		                    TREATAS ( { v_categoryA }, 'Product'[Category] ),
		                    TREATAS ( { v_categoryB }, 'Product (Basket)'[Category] )
		                ),
		                CALCULATETABLE (
		                    Tests.BasketGroupContext ( "Subcategory all history" ),
		                    TREATAS ( { v_subcategoryA }, 'Product'[Subcategory] ),
		                    TREATAS ( { v_subcategoryB }, 'Product (Basket)'[Subcategory] )
		                ),
		                CALCULATETABLE (
		                    Tests.BasketGroupContext ( "Category May2017 Store" ),
		                    TREATAS ( { v_categoryA }, 'Product'[Category] ),
		                    TREATAS ( { v_categoryB }, 'Product (Basket)'[Category] ),
		                    DATESBETWEEN ( 'Calendar'[Date], DATE ( 2017, 5, 1 ), DATE ( 2017, 5, 31 ) ),
		                    TREATAS ( { 999999 }, 'Store'[StoreKey] )
		                ),
		                CALCULATETABLE (
		                    Tests.BasketGroupContext ( "Subcategory May2017 Store" ),
		                    TREATAS ( { v_subcategoryA }, 'Product'[Subcategory] ),
		                    TREATAS ( { v_subcategoryB }, 'Product (Basket)'[Subcategory] ),
		                    DATESBETWEEN ( 'Calendar'[Date], DATE ( 2017, 5, 1 ), DATE ( 2017, 5, 31 ) ),
		                    TREATAS ( { 999999 }, 'Store'[StoreKey] )
		                )
		            ),
		        CALCULATETABLE (
		            UNION (
		                Tests.BasketPair ( 18, 444, "May2017" ),
		                Tests.BasketPair ( 113, 1577, "May2017" ),
		                Tests.BasketPair ( 216, 648, "May2017" )
		            ),
		            DATESBETWEEN ( 'Calendar'[Date], DATE ( 2017, 5, 1 ), DATE ( 2017, 5, 31 ) )
		        ),
		        VAR v_fixtureCustomer =
		            CALCULATE (
		                SELECTEDVALUE ( 'Sales'[CustomerKey] ),
		                TREATAS ( { 269500 }, 'Sales'[Order Number] )
		            )
		        RETURN
		            CALCULATETABLE (
		                Tests.BasketPair ( 18, 444, "combined Date Customer Store" ),
		                TREATAS ( { DATE ( 2017, 5, 18 ) }, 'Calendar'[Date] ),
		                TREATAS ( { v_fixtureCustomer }, 'Customer'[CustomerKey] ),
		                TREATAS ( { 999999 }, 'Store'[StoreKey] )
		            ),
		        PQL.Assert.ShouldEqual ( "MBA MINIMUM SUPPORT default", 0.005, CALCULATE ( [MINIMUM SUPPORT], REMOVEFILTERS ( 'Minimum Support' ) ) ),
		        PQL.Assert.ShouldEqual ( "MBA MINIMUM LIFT default", 1.2, CALCULATE ( [MINIMUM LIFT], REMOVEFILTERS ( 'Minimum Lift' ) ) ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA MINIMUM SUPPORT selected upper boundary", 1, [MINIMUM SUPPORT] ),
		                PQL.Assert.ShouldEqual ( "MBA MINIMUM LIFT selected upper boundary", 10, [MINIMUM LIFT] )
		            ),
		            TREATAS ( { 1 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 10 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA MINIMUM SUPPORT multiple selections defaults", 0.005, [MINIMUM SUPPORT] ),
		                PQL.Assert.ShouldEqual ( "MBA MINIMUM LIFT multiple selections defaults", 1.2, [MINIMUM LIFT] )
		            ),
		            TREATAS ( { 0, 1 }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { 0, 10 }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA MINIMUM SUPPORT blank selection defaults", 0.005, [MINIMUM SUPPORT] ),
		                PQL.Assert.ShouldEqual ( "MBA MINIMUM LIFT blank selection defaults", 1.2, [MINIMUM LIFT] )
		            ),
		            TREATAS ( { BLANK () }, 'Minimum Support'[Minimum Support] ),
		            TREATAS ( { BLANK () }, 'Minimum Lift'[Minimum Lift] )
		        ),
		        CALCULATETABLE (
		            PQL.Assert.ShouldBeNull ( "MBA blank product member has no pair", [PAIR ELIGIBLE] ),
		            TREATAS ( { BLANK () }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        VAR v_rawSupport =
		            CALCULATE (
		                [SUPPORT],
		                TREATAS ( { 18 }, 'Product'[ProductKey] ),
		                TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] ),
		                REMOVEFILTERS ( 'Minimum Support' ),
		                REMOVEFILTERS ( 'Minimum Lift' )
		            )
		        RETURN
		            CALCULATETABLE (
		                UNION (
		                    PQL.Assert.ShouldEqual ( "MBA thresholds leave raw SUPPORT unchanged", v_rawSupport, [SUPPORT] ),
		                    PQL.Assert.ShouldBeNull ( "MBA high threshold hides fixture pair", [PAIR ELIGIBLE] )
		                ),
		                TREATAS ( { 18 }, 'Product'[ProductKey] ),
		                TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] ),
		                TREATAS ( { 1 }, 'Minimum Support'[Minimum Support] ),
		                TREATAS ( { 10 }, 'Minimum Lift'[Minimum Lift] )
		            ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldBeNull ( "MBA self Product SUPPORT", [SUPPORT] ),
		                PQL.Assert.ShouldBeNull ( "MBA self Product PAIR ELIGIBLE", [PAIR ELIGIBLE] ),
		                PQL.Assert.ShouldBeNull ( "MBA self Product ORDER IN PAIR SAMPLE", [ORDER IN PAIR SAMPLE] )
		            ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 18 }, 'Product (Basket)'[ProductKey] )
		        ),
		        VAR v_category = MINX ( FILTER ( ALL ( 'Product' ), NOT ISBLANK ( 'Product'[Category] ) ), 'Product'[Category] )
		        RETURN
		            CALCULATETABLE (
		                PQL.Assert.ShouldBeNull ( "MBA self Category LIFT", [LIFT] ),
		                TREATAS ( { v_category }, 'Product'[Category] ),
		                TREATAS ( { v_category }, 'Product (Basket)'[Category] )
		            ),
		        VAR v_subcategory = MINX ( FILTER ( ALL ( 'Product' ), NOT ISBLANK ( 'Product'[Subcategory] ) ), 'Product'[Subcategory] )
		        RETURN
		            CALCULATETABLE (
		                PQL.Assert.ShouldBeNull ( "MBA self Subcategory LIFT", [LIFT] ),
		                TREATAS ( { v_subcategory }, 'Product'[Subcategory] ),
		                TREATAS ( { v_subcategory }, 'Product (Basket)'[Subcategory] )
		            ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldBeNull ( "MBA ambiguous pair total SUPPORT", [SUPPORT] ),
		                PQL.Assert.ShouldBeNull ( "MBA ambiguous pair total PAIR ELIGIBLE", [PAIR ELIGIBLE] )
		            ),
		            REMOVEFILTERS ( 'Product' ),
		            REMOVEFILTERS ( 'Product (Basket)' )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldBeNull ( "MBA no orders TOTAL ORDERS", [TOTAL ORDERS] ),
		                PQL.Assert.ShouldBeNull ( "MBA no orders SUPPORT", [SUPPORT] ),
		                PQL.Assert.ShouldBeNull ( "MBA no orders CONFIDENCE", [CONFIDENCE] ),
		                PQL.Assert.ShouldBeNull ( "MBA no orders LIFT", [LIFT] ),
		                PQL.Assert.ShouldBeNull ( "MBA no orders AVG BASKET SIZE", [AVG BASKET SIZE] ),
		                PQL.Assert.ShouldBeNull ( "MBA no orders AVG ITEMS PER ORDER", [AVG ITEMS PER ORDER] )
		            ),
		            TREATAS ( { DATE ( 1900, 1, 1 ) }, 'Calendar'[Date] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldBeNull ( "MBA nonpositive line scope TOTAL ORDERS", [TOTAL ORDERS] ),
		                PQL.Assert.ShouldEqual ( "MBA nonpositive line scope joint", 0, [ORDERS WITH A AND B] )
		            ),
		            KEEPFILTERS ( 'Sales'[Quantity] <= 0 ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldBeGreaterThan ( "MBA real fixture one joint order", 0, [ORDERS WITH A AND B] ),
		                PQL.Assert.ShouldEqual ( "MBA fixture distinct product basket average", 3, [AVG BASKET SIZE] ),
		                PQL.Assert.ShouldEqual ( "MBA fixture positive units average", 10, [AVG ITEMS PER ORDER] ),
		                PQL.Assert.ShouldEqual (
		                    "MBA PAIR ELIGIBLE includes exact support and lift boundaries",
		                    1,
		                    CALCULATE ( [PAIR ELIGIBLE], TREATAS ( { 1 }, 'Minimum Support'[Minimum Support] ), TREATAS ( { 1 }, 'Minimum Lift'[Minimum Lift] ) )
		                ),
		                PQL.Assert.ShouldEqual ( "MBA sample ignores fact ProductKey and Line Number", 1, CALCULATE ( [ORDER IN PAIR SAMPLE], TREATAS ( { 18 }, 'Sales'[ProductKey] ), TREATAS ( { 1 }, 'Sales'[Line Number] ) ) )
		            ),
		            TREATAS ( { 269500 }, 'Sales'[Order Number] ),
		            TREATAS ( { 18 }, 'Product'[ProductKey] ),
		            TREATAS ( { 444 }, 'Product (Basket)'[ProductKey] )
		        ),
		        CALCULATETABLE (
		            UNION (
		                PQL.Assert.ShouldEqual ( "MBA repeated product lines count one basket", 1, [TOTAL ORDERS] ),
		                PQL.Assert.ShouldEqual ( "MBA repeated product lines count three products not four lines", 3, [AVG BASKET SIZE] ),
		                PQL.Assert.ShouldEqual ( "MBA repeated product lines retain all positive units", 13, [AVG ITEMS PER ORDER] ),
		                PQL.Assert.ShouldEqual ( "MBA repeated-line fixture has four qualifying lines", 4, CALCULATE ( COUNTROWS ( 'Sales' ), 'Sales'[Quantity] > 0 ) )
		            ),
		            TREATAS ( { 284405 }, 'Sales'[Order Number] )
		        )
		    )

/// DAX Assertion Library Functions
/// Publisher: PQL (Power Query Lint)
/// These functions provide a standardized way to write unit tests for DAX models
/// Basic Assertions - PQL.Assert namespace
/// Asserts that a condition is TRUE. The BOOLEAN parameter converts BLANK() to FALSE before the function runs, so a BLANK condition fails here and passes ShouldBeFalse. Use ShouldNotBeNull first when the value can be BLANK.
function 'PQL.Assert.ShouldBeTrue' =
		(testName : STRING, actualCondition : BOOLEAN) =>
		    VAR _Passed = actualCondition = TRUE
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "TRUE",
		        "Actual", IF(actualCondition, "TRUE", "FALSE"),
		        "Passed", _Passed
		    )
	lineageTag: 15d834e1-e3c1-4800-8307-da51107a7f28

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a condition is FALSE. The BOOLEAN parameter converts BLANK() to FALSE before the function runs, so a BLANK condition passes. Use ShouldNotBeNull first when the value can be BLANK.
function 'PQL.Assert.ShouldBeFalse' =
		(testName : STRING, actualCondition : BOOLEAN) =>
		    VAR _Passed = actualCondition = FALSE
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "FALSE",
		        "Actual", IF(actualCondition, "TRUE", "FALSE"),
		        "Passed", _Passed
		    )
	lineageTag: d2a7099f-f955-4098-95ab-7b33c0037642

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is NULL (DAX BLANK()).
function 'PQL.Assert.ShouldBeNull' =
		(testName : STRING, actualValue : VARIANT) =>
		    VAR _Passed = ISBLANK(actualValue)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NULL",
		        "Actual", IF(ISBLANK(actualValue), "NULL", IF(EXACT(actualValue, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 5aff047b-652a-4252-8788-56d0929cf3e5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is not NULL (not DAX BLANK()). Accepts both simple values and expressions.
function 'PQL.Assert.ShouldNotBeNull' =
		(testName : STRING, actualValue : SCALAR VARIANT EXPR) =>
		    VAR _ActualResult = actualValue
		    VAR _Passed = NOT ISBLANK(_ActualResult)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NOT NULL",
		        "Actual", IF(ISBLANK(_ActualResult), "NULL", IF(EXACT(_ActualResult, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 9dededf1-c704-44f2-893b-b6b6140af51f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is BLANK (empty string "").
function 'PQL.Assert.ShouldBeBlank' =
		(testName : STRING, actualValue : VARIANT) =>
		    VAR _Passed = NOT ISBLANK(actualValue) && EXACT(actualValue, "")
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "BLANK (empty string)",
		        "Actual", IF(ISBLANK(actualValue), "NULL", IF(EXACT(actualValue, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 7b32192b-212c-431d-8cab-20ee570086d5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a value is not BLANK (not empty string "").
function 'PQL.Assert.ShouldNotBeBlank' =
		(testName : STRING, actualValue : SCALAR VARIANT EXPR) =>
		    VAR _ActualResult = actualValue
		    VAR _Passed = ISBLANK(_ActualResult) || NOT EXACT(_ActualResult, "")
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "NOT BLANK (not empty string)",
		        "Actual", IF(ISBLANK(_ActualResult), "NULL", IF(EXACT(_ActualResult, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", _Passed
		    )
	lineageTag: 859aee01-e56e-4c70-9ef9-631fd07814f0

