/// String Assertions - PQL.Assert namespace
/// Asserts that a string starts with the specified prefix (case-insensitive). A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldStartWith' =
		(testName : STRING, prefix : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && LEFT(UPPER(actual), LEN(prefix)) = UPPER(prefix)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Starts with '" & prefix & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
	lineageTag: 2ed2f5ac-4ca0-42a9-8ae5-774e992fbb9f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a string ends with the specified suffix (case-insensitive). A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldEndWith' =
		(testName : STRING, suffix : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && RIGHT(UPPER(actual), LEN(suffix)) = UPPER(suffix)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Ends with '" & suffix & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
