/// Sales lines at order-line grain. Sales Amount is quantity times net price; Currency Code is available, but no consolidated currency is defined. Calendar filters Order Date, not Delivery Date.
table Sales
	lineageTag: 97143e5b-7736-4fcb-8042-26b92b1f5684

	/// Distinct customers with at least one sales line in the current filter context.
	measure '# Customers (w/ Sales)' = DISTINCTCOUNT('Sales'[CustomerKey])
		formatString: #,##0
		lineageTag: 4ec872f0-a42d-4aa9-bf6b-1ca7c4916336

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total units on sales lines in the current filter context. Source quantities are randomized at refresh; treat as sample analysis, not certified company units.
	measure 'Sales Qty' = sum('Sales'[Quantity])
		formatString: #,##0
		lineageTag: c2ff8d96-2f03-4005-84df-91458625b73b

	/// Sum of line quantity times net price. Source values are randomized at refresh; Currency Code exists, but this measure does not define a consolidated-currency total.
	measure 'Sales Amount' = SUMX('Sales', 'Sales'[Quantity] * 'Sales'[Net Price])
		formatString: $ #,##0
		lineageTag: a8e95485-02a2-4525-b02a-b2418fbdbe4c

	/// Sales Amount for the same selected dates one year earlier, using Calendar[Date]. Returns blank unless current Sales Amount is positive; currency consolidation is not defined.
	measure 'Sales Amount (LY)' = IF ([Sales Amount] > 0, CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Calendar'[Date])))
		formatString: $ #,##0
		lineageTag: 3fa889ae-64b9-4a6e-b0e6-c81c90fd32bf

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average nonblank daily Sales Amount across dates in the current Calendar selection; dates without sales are omitted, not zero. Currency consolidation is not defined.
	measure 'Sales Amount Avg per Day' = AVERAGEX(VALUES('Calendar'[Date]), [Sales Amount])
		formatString: $ #,##0
		lineageTag: 65842ce7-7176-4106-868e-2e83aaa62b4c

	/// Sum of line quantity times net price less unit cost. Source amounts are randomized at refresh; a consolidated-currency result is not defined.
	measure Margin =
			SUMX (
			    Sales,
			    Sales[Quantity]
			        * ( Sales[Net Price] - Sales[Unit Cost] )
			)
		formatString: $ #,##0
		lineageTag: d22a262b-b776-4ccd-b9bd-7ef9c90eba51

	/// Count of sales rows (order lines) in the current context; this is not a distinct order count.
	measure '# Sales' = COUNTROWS('Sales')
		formatString: #,##0
		lineageTag: 67791bd1-5f33-4a29-a9ac-be0ad2453fcf

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average nonblank daily Sales Amount in the trailing 12 months ending on the last selected Calendar date. Blank when period starts after latest order date; currency consolidation is not defined.
	measure 'Sales Amount (12M average)' =
			
			VAR v_selDate =
			    MAX ( 'Calendar'[Date] )
			VAR v_period =
			    DATESINPERIOD ( 'Calendar'[Date], v_selDate, -12, MONTH )
			VAR v_result =
			    CALCULATE ( AVERAGEX ( VALUES ( 'Calendar'[Date] ), [Sales Amount] ), v_period )
			VAR v_firstDate =
			    MINX ( v_period, 'Calendar'[Date] )
			VAR v_lastDateSales =
			    MAX ( Sales[Order Date] )
			RETURN
			    IF ( v_firstDate <= v_lastDateSales, v_result )
		formatString: $ #,##0
		lineageTag: 7fd60f7e-287e-46c3-a745-24c4507bc77b

	/// Average nonblank daily Sales Amount in the trailing 6 months ending on the last selected Calendar date. Blank when period starts after latest order date; currency consolidation is not defined.
	measure 'Sales Amount (6M average)' =
			VAR v_selDate =
			    MAX ( 'Calendar'[Date] )
			VAR v_period =
			    DATESINPERIOD ( 'Calendar'[Date], v_selDate, -6, MONTH )
			VAR v_result =
			    CALCULATE ( AVERAGEX ( VALUES ( 'Calendar'[Date] ), [Sales Amount] ), v_period )
			VAR v_firstDate =
			    MINX ( v_period, 'Calendar'[Date] )
			VAR v_lastDateSales =
			    MAX ( Sales[Order Date] )
			RETURN
			    IF ( v_firstDate <= v_lastDateSales, v_result )
		formatString: $ #,##0
		lineageTag: 9a48bea0-e5fb-40fa-9e81-f61288e31a02

	/// Sum of line quantity times unit cost in the current filter context. Source values are randomized; no consolidated-currency result is defined.
	measure Cost = SUMX ( Sales, Sales[Quantity] * Sales[Unit Cost] )
		formatString: $ #,##0
		lineageTag: 3e5cb67e-a411-476f-ad34-7ec10dfd084d

	/// Distinct customers whose first order date falls in the selected date context. Customer and Calendar selections plus remaining product, category, brand and other filters affect this classification.
	measure '# New Customers' = ```
			
			VAR CustomersWithNewDate =
			    CALCULATETABLE (                        -- Prepares a table that 
			        ADDCOLUMNS (                        -- for each customer contains
			            VALUES ( Sales[CustomerKey] ),  -- the date of their first purchase
			            "@NewCustomerDate", CALCULATE (        
			    MIN ( Sales[Order Date] ),  -- The date of the first sale is the MIN of Order Date
			    REMOVEFILTERS ( 'Calendar'[Date] )    -- at any time in the past
			)
			        ),
			        ALLSELECTED ( Customer ),           -- Regardless of local filters on Customer
			        ALLSELECTED ( 'Calendar' )              -- and on Date
			    ) 
			VAR CustomersWithLineage =                  -- Here we change the data lineage
			    TREATAS (                               -- of the CustomersWithNewDate variable
			        CustomersWithNewDate,               -- so that it filters the 
			        Sales[CustomerKey],                 -- Customer Key and the
			        'Calendar'[Date]                        -- Date columns in different tables
			    )
			VAR Result =                                 
			    CALCULATE (                             
			        DISTINCTCOUNT ( Sales[CustomerKey] ), -- Counts the number of customers only
			        KEEPFILTERS ( CustomersWithLineage )  -- if they appear in their @NewCustomerDate
			    )
			RETURN
			    Result
			
			```
		formatString: #,##0
		lineageTag: f7fd3d2d-9a79-4951-b933-d6c7c7840fa8

		annotation PBI_FormatHint = {"isCustom":true}

	/// Customers with sales who are not new in the same context. Uses the same customer, calendar and remaining filters as # New Customers; a period with first and later sales counts as new only.
	measure '# Returning Customers' = [# Customers (w/ Sales)] - [# New Customers]
		formatString: #,##0
		lineageTag: 776a5215-e6ed-42f1-af05-6475332d8cec

		annotation PBI_FormatHint = {"isCustom":true}

	/// Numeric order identifier that can repeat across sales lines. Use # Sales for line counts; it is not a distinct order count.
	column 'Order Number'
		dataType: int64
		formatString: 0
		lineageTag: e2e629f1-f1fb-4444-a627-b121d77fdc06
		summarizeBy: none
		sourceColumn: Order Number

		annotation SummarizationSetBy = User

	/// Sequence number within an order; use with Order Number to identify an individual sales line.
	column 'Line Number'
		dataType: int64
		formatString: 0
		lineageTag: d4046972-90a5-46b2-badb-709e834b99af
		summarizeBy: none
		sourceColumn: Line Number

		annotation SummarizationSetBy = User

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		isAvailableInMdx: false
		lineageTag: d2d074d6-be1f-4dfd-b826-cd99fe83bc3a
		summarizeBy: none
		sourceColumn: Order Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Date an order line was delivered. It is not related to Calendar, so Calendar selections do not filter by this date.
	column 'Delivery Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 1056fc0f-d1e5-4872-a39b-25603dba5cf5
		summarizeBy: none
		sourceColumn: Delivery Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 4de77f33-318d-4006-85db-580cb119fc6a
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	column StoreKey
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: cf26d73c-10d7-40ac-83a3-c91c04e948d8
		summarizeBy: none
		sourceColumn: StoreKey

