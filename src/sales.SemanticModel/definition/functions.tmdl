/// Asserts that a number is greater than or equal to a threshold. A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as 0).
function 'PQL.Assert.ShouldBeGreaterOrEqual' =
		(testName : STRING, threshold : DOUBLE, actual : DOUBLE) =>
		    VAR _Passed = NOT ISBLANK(actual) && actual >= threshold
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", ">= " & FORMAT(threshold, ""),
		        "Actual", IF(ISBLANK(actual), "NULL", FORMAT(actual, "")),
		        "Passed", _Passed
		    )
	lineageTag: 7d53aa96-2534-4094-ad36-8c1611c31728

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.8.0

/// Asserts that a number is less than or equal to a threshold. A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as 0).
function 'PQL.Assert.ShouldBeLessOrEqual' =
		(testName : STRING, threshold : DOUBLE, actual : DOUBLE) =>
		    VAR _Passed = NOT ISBLANK(actual) && actual <= threshold
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "<= " & FORMAT(threshold, ""),
		        "Actual", IF(ISBLANK(actual), "NULL", FORMAT(actual, "")),
		        "Passed", _Passed
		    )
