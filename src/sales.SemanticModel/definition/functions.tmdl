/// Asserts that a string contains a pattern (case-insensitive). Uses CONTAINSSTRING: a substring match where ? matches one character and * matches any run of characters. It is not a regular expression and does not need to match the whole value. A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldMatch' =
		(testName : STRING, pattern : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && CONTAINSSTRING(actual, pattern)
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Matches '" & pattern & "'",
		        "Actual", IF(ISBLANK(actual), "NULL", actual),
		        "Passed", _Passed
		    )
