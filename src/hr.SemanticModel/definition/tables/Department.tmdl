/// Six fictional organizational departments, one row per department.
table Department

	column 'Department Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Department Key

	column Department
		dataType: string
		isDefaultLabel
		summarizeBy: none
		sourceColumn: Department

	column Division
		dataType: string
		summarizeBy: none
		sourceColumn: Division

	column 'Cost Center'
		dataType: string
		summarizeBy: none
		sourceColumn: Cost Center

	partition Department = m
		mode: import
		source =
				#table(
				    type table [#"Department Key" = Int64.Type, Department = text, Division = text, #"Cost Center" = text],
				    {
				        {1, "Stores", "Retail", "NRG-101"},
				        {2, "Digital", "Commerce", "NRG-102"},
				        {3, "Supply Chain", "Operations", "NRG-103"},
				        {4, "Merchandising", "Commerce", "NRG-104"},
				        {5, "Finance", "Corporate", "NRG-105"},
				        {6, "People", "Corporate", "NRG-106"}
				    })
