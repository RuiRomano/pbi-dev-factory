/// One row per hire or exit, dated at the event, for the fictional workforce through December 2025.
table Movements

	/// Number of fictional hire events in the selected dates; returns blank when none exist.
	measure HIRES =
			CALCULATE (
			    COUNTROWS ( 'Movements' ),
			    KEEPFILTERS ( 'Movements'[Movement Type] = "Hire" )
			)
		formatString: #,##0

	/// Number of fictional employee exit events in the selected dates; returns blank when none exist.
	measure EXITS =
			CALCULATE (
			    COUNTROWS ( 'Movements' ),
			    KEEPFILTERS ( 'Movements'[Movement Type] = "Exit" )
			)
		formatString: #,##0

	/// Exits in the trailing 12 complete months divided by average monthly headcount in those same months. Blank without 12 snapshots or a positive denominator.
	measure 'ATTRITION RATE' =
			VAR _selectedDate = MAX ( 'Calendar'[Date] )
			VAR _end = IF ( _selectedDate = EOMONTH ( _selectedDate, 0 ), _selectedDate, EOMONTH ( _selectedDate, -1 ) )
			VAR _start = EOMONTH ( _end, -12 ) + 1
			VAR _snapshots =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Headcount'[Snapshot Date] ),
			        REMOVEFILTERS ( 'Calendar' ),
			        DATESBETWEEN ( 'Calendar'[Date], _start, _end )
			    )
			VAR _exits =
			    CALCULATE (
			        [EXITS],
			        REMOVEFILTERS ( 'Calendar' ),
			        DATESBETWEEN ( 'Calendar'[Date], _start, _end )
			    )
			VAR _months =
			    CALCULATETABLE (
			        VALUES ( 'Calendar'[Month End] ),
			        REMOVEFILTERS ( 'Calendar' ),
			        DATESBETWEEN ( 'Calendar'[Date], _start, _end )
			    )
			VAR _average =
			    AVERAGEX (
			        _months,
			        VAR _monthEnd = 'Calendar'[Month End]
			        RETURN
			            CALCULATE (
			                [HEADCOUNT],
			                REMOVEFILTERS ( 'Calendar' ),
			                TREATAS ( { _monthEnd }, 'Calendar'[Date] )
			            )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _selectedDate ) && _snapshots = 12, DIVIDE ( _exits, _average ) )
		formatString: 0.0%

	/// Trailing twelve-complete-month attrition rate as of the corresponding month end one year earlier.
	measure 'ATTRITION RATE LY' =
			VAR _date = MAX ( 'Calendar'[Date] )
			VAR _priorMonthEnd = EOMONTH ( _date, -12 )
			RETURN
			    IF (
			        NOT ISBLANK ( _date ),
			        CALCULATE (
			            [ATTRITION RATE],
			            REMOVEFILTERS ( 'Calendar' ),
			            TREATAS ( { _priorMonthEnd }, 'Calendar'[Date] )
			        )
			    )
		formatString: 0.0%

	column 'Employee Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Employee Key

	column 'Department Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Department Key

	column 'Location Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Location Key

	column 'Event Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Event Date

	column 'Movement Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Movement Type

	column 'Exit Reason'
		dataType: string
		summarizeBy: none
		sourceColumn: Exit Reason

	column 'Tenure Band'
		dataType: string
		summarizeBy: none
		sourceColumn: Tenure Band
		sortByColumn: 'Tenure Order'

	column 'Tenure Order'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Tenure Order

	partition Movements = m
		mode: import
		source =
				let
				    Roster = Table.ToRecords(EmployeeRows),
				    Events = List.Combine(List.Transform(Roster, (person) =>
				        let
				            hire = [
				                #"Employee Key" = person[Employee Key],
				                #"Department Key" = person[Department Key],
				                #"Location Key" = person[Location Key],
				                #"Event Date" = person[Hire Date],
				                #"Movement Type" = "Hire",
				                #"Exit Reason" = null,
				                #"Tenure Band" = null,
				                #"Tenure Order" = null
				            ],
				            exitDate = person[Termination Date],
				            years = if exitDate = null then null else Duration.Days(exitDate - person[Hire Date]) / 365.25,
				            bandOrder = if years = null then null else if years < 1 then 1 else if years < 3 then 2 else if years < 5 then 3 else 4,
				            exit = [
				                #"Employee Key" = person[Employee Key],
				                #"Department Key" = person[Department Key],
				                #"Location Key" = person[Location Key],
				                #"Event Date" = exitDate,
				                #"Movement Type" = "Exit",
				                #"Exit Reason" = person[Exit Reason],
				                #"Tenure Band" = if bandOrder = null then null else {"< 1 year", "1–3 years", "3–5 years", "5+ years"}{bandOrder - 1},
				                #"Tenure Order" = bandOrder
				            ]
				        in
				            if exitDate = null then {hire} else {hire, exit})),
				    Rows = Table.FromRecords(Events),
				    Typed = Table.TransformColumnTypes(Rows, {
				        {"Employee Key", Int64.Type}, {"Department Key", Int64.Type},
				        {"Location Key", Int64.Type},
				        {"Event Date", type date}, {"Movement Type", type text},
				        {"Exit Reason", type text}, {"Tenure Band", type text},
				        {"Tenure Order", Int64.Type}})
				in
				    Typed
